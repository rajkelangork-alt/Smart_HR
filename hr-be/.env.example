# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:1234@localhost:5432/smart_hr_db?schema=public"

# Redis Configuration (Cache & Bull Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=supersecretjwtkey_replace_in_production_min32chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=supersecretrefreshkey_replace_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# LDAP / Active Directory
LDAP_URL=ldap://127.0.0.1:389
LDAP_BIND_DN=cn=admin,dc=example,dc=org
LDAP_BIND_PASSWORD=adminpassword
LDAP_SEARCH_BASE=dc=example,dc=org

# File Upload Defaults
MAX_FILE_SIZE_MB=10
UPLOAD_DESTINATION=./uploads